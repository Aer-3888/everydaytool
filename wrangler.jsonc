{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "everydaytool",
  "main": "./worker/index.ts",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ADMIN_EMAIL": "theo.phan.quoc.huy@gmail.com"
  },
  "secrets": {
    "required": ["GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "everydaytool",
      "database_id": "17e3a9f8-c604-47fa-a75b-2ec2344e445b",
      "migrations_dir": "./drizzle"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
